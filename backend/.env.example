# From @BotFather
TELEGRAM_BOT_TOKEN=
# Any long random string. The ESP32 sends it in the X-Device-Token header.
DEVICE_TOKEN=

# Optional
# Comma-separated Telegram chat IDs allowed to subscribe. Leave unset to let anyone subscribe.
# ALLOWED_CHAT_IDS=123456789,987654321
# PORT=3000
# OFFLINE_TIMEOUT_SECONDS=30
# Outages shorter than this are left out of /stats and the charts (they are still notified).
# MIN_STATS_OUTAGE_SECONDS=300
# On Railway, set this to a path on a volume (e.g. /data/status.json), or subscribers are lost on every redeploy.
# The folder must already exist: the server crashes on the first heartbeat if it doesn't.
# STATE_FILE=status.json
